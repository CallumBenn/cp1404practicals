BoxLayout:
    orientation: 'vertical'
    BoxLayout:
        orientation: 'horizontal'
        TextInput:
            id: input_number
            text: '0'
            font_size: 26
            multiline: False
            on_text: app.handle_calculate(input_number.text)
        BoxLayout:
            size_hint_x: 0.25
            orientation: 'vertical'
            Button:
                id: add
                text: 'Up'
                font_size: 16
                on_press: app.add_miles(input_number.text)
            Button:
                id: subtract
                font_size: 16
                text: 'Down'
                on_press: app.subtract_miles(input_number.text)
    Label:
#        id: output_label
        text: app.message
        font_size: 26
        color: (1, 1, 0, 1)

